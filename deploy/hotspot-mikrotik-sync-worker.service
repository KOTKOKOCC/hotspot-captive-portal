[Unit]
Description=Hotspot MikroTik Sync Worker
After=network.target

[Service]
WorkingDirectory=/opt/hotspot-captive-portal
EnvironmentFile=/opt/hotspot-captive-portal/.env
ExecStart=/opt/hotspot-captive-portal/.venv/bin/python /opt/hotspot-captive-portal/workers/mikrotik_sync_worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
